{
  "folderUid": "ai-lab",
  "folderTitle": "AI Lab",
  "group": "ai-lab",
  "interval": "1m",
  "rules": [
    {
      "uid": "ai-lab-gpu-hot",
      "title": "GPU hot",
      "ruleGroup": "ai-lab",
      "folderUID": "ai-lab",
      "orgID": 1,
      "condition": "C",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {
            "from": 600,
            "to": 0
          },
          "datasourceUid": "__DS_PROM__",
          "model": {
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "__DS_PROM__"
            },
            "expr": "(max(ai_lab_gpu_temperature_celsius > bool 85) or vector(0)) + (max(ai_lab_gpu_throttled{reason=~\".*thermal.*\"} > bool 0) or vector(0))",
            "instant": true,
            "range": false,
            "intervalMs": 1000,
            "maxDataPoints": 43200
          }
        },
        {
          "refId": "B",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "B",
            "type": "reduce",
            "expression": "A",
            "reducer": "last",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "settings": {
              "mode": "dropNN"
            }
          }
        },
        {
          "refId": "C",
          "relativeTimeRange": {
            "from": 0,
            "to": 0
          },
          "datasourceUid": "__expr__",
          "model": {
            "refId": "C",
            "type": "threshold",
            "expression": "B",
            "datasource": {
              "type": "__expr__",
              "uid": "__expr__"
            },
            "conditions": [
              {
                "type": "query",
                "evaluator": {
                  "type": "gt",
                  "params": [
                    0
                  ]
                },
                "operator": {
                  "type": "and"
                },
                "query": {
                  "params": [
                    "C"
                  ]
                },
                "reducer": {
                  "type": "last",
                  "params": []
                }
              }
            ]
          }
        }
      ],
      "for": "5m",
      "noDataState": "OK",
      "execErrState": "Error",
      "isPaused": false,
      "annotations": {
        "summary": "GPU temperature has been above 85 \u00b0C, or a thermal throttle is active, for 5 minutes."
      },
      "labels": {
        "severity": "warning",
        "app": "ai-lab"
      }
    },
