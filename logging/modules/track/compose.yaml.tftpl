services:
  victorialogs:
    image: victoriametrics/victoria-logs:v1.53.0@sha256:251121fa882af99b95ba0c230a4a2f412ea602d2698c64a96c58dc9842bb755d
    command: -storageDataPath=/data -retentionPeriod=30d
    ports:
      - "127.0.0.1:9428:9428"
    volumes:
      - victorialogs:/data
    restart: unless-stopped
volumes:
  victorialogs: {}
