aws_region  = "us-east-1"
aws_profile = "CHANGEME"

project_name = "ollama-open-webui-lab"

instance_type    = "c7i.4xlarge"
root_volume_size = 80
ollama_model     = "llama3.2:3b"

open_webui_admin_email = "admin@example.local"
open_webui_admin_name  = "Lab Admin"

# The Terraform variable has a temporary default: ChangeMeBeforeUse123!
# Override it before real use with TF_VAR_open_webui_admin_password
# or a local terraform.tfvars file, which is ignored by .gitignore.
# open_webui_admin_password = "replace-with-a-strong-local-password"

# SSH is disabled by default. Prefer SSM port forwarding.
enable_ssh       = false
ssh_key_name     = null
allowed_ssh_cidr = null
