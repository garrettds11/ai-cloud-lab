    {
      "type": "stat",
      "title": "Telemetry",
      "description": "Up when the metrics exporter on the instance reported in the last 3 minutes.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "(time() - max(ai_lab_exporter_last_success_timestamp_seconds)) < bool 180",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": null,
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "Up",
                  "color": "green"
                },
                "0": {
                  "text": "Down",
                  "color": "red"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No data",
                  "color": "text"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
