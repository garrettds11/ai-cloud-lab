aws_region  = "us-east-1"
# Optional. Leave null to use environment variables, SSO, or an instance/CI role.
aws_profile = null

project_name = "ollama-open-webui-lab"

instance_type    = "c7i.4xlarge"
root_volume_size = 80
ollama_model     = "llama3.2:3b"

open_webui_admin_email = "admin@example.local"
open_webui_admin_name  = "Lab Admin"

# Create this secret in AWS Secrets Manager before apply, then set its ARN
# with TF_VAR_open_webui_admin_password_secret_arn or in a local
# terraform.tfvars file, which is ignored by .gitignore.
# open_webui_admin_password_secret_arn = "arn:aws:secretsmanager:region:account:secret:name-suffix"
# Create a second secret for the four demo users and set its ARN here.
# open_webui_demo_user_password_secret_arn = "arn:aws:secretsmanager:region:account:secret:openwebui-demo-pass-suffix"
# The default configuration creates demo1@example.local through
# demo4@example.local. Override open_webui_demo_users to change their names
# or email addresses, while keeping exactly four entries for this demo.

# Optional public HTTPS access through an ALB and Route 53 alias.
# enable_domain_access = true
# enable_cloudflare_access = true
# domain_name         = "aiwebdemo.click"
# route53_zone_name   = "aiwebdemo.click"
acm_certificate_arn = "arn:aws:acm:us-east-1:394566733278:certificate/1163bb42-f265-4702-aad2-868c677ee07a"

# Cloudflare deployment values. Replace this block when cloning the repo; do
# not store the API token itself here.
cloudflare_account_id            = "d45c08a8bcf24bb2bf81fe0df99fcbc8"
cloudflare_api_token_secret_arn  = "arn:aws:secretsmanager:us-east-1:394566733278:secret:CLOUDFLARE_API_TOKEN-LxdgxA"
cloudflare_access_allowed_emails = ["garrettds11@gmail.com"]

# SSH is disabled by default. Prefer SSM port forwarding.
enable_ssh       = false
ssh_key_name     = null
allowed_ssh_cidr = null
