{
  "uid": "ai-lab-tokenomics",
  "title": "AI Lab: Tokenomics",
  "description": "Tokens, what they cost on this lab, and what the same tokens would cost on a hosted API. Per-person figures are on the control panel.",
  "tags": [
    "ai-lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds_prom",
        "label": "Metrics",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "datasource",
        "name": "ds_loki",
        "label": "Logs",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "datasource",
        "name": "ds_cw",
        "label": "CloudWatch",
        "query": "cloudwatch",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "textbox",
        "name": "price_in",
        "label": "Hosted API price per 1M input tokens (USD)",
        "query": "3",
        "current": {
          "text": "3",
          "value": "3"
        },
        "options": [
          {
            "selected": true,
            "text": "3",
            "value": "3"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "price_out",
        "label": "Hosted API price per 1M output tokens (USD)",
        "query": "15",
        "current": {
          "text": "15",
          "value": "15"
        },
        "options": [
          {
            "selected": true,
            "text": "15",
            "value": "15"
          }
        ],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Over the selected time range",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Tokens",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum(increase(ai_lab_tokens_total[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Input tokens",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum(increase(ai_lab_tokens_total{direction=\"input\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Output tokens",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum(increase(ai_lab_tokens_total{direction=\"output\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Lab cost",
      "description": "Hourly price times the minutes the instance reported in.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "max(ai_lab_instance_hourly_cost_usd) * count_over_time(max(ai_lab_exporter_last_success_timestamp_seconds)[$__range:1m]) / 60",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Cost per 1M tokens",
      "description": "Lab cost divided by tokens. Falls as the lab is used more.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "(max(ai_lab_instance_hourly_cost_usd) * count_over_time(max(ai_lab_exporter_last_success_timestamp_seconds)[$__range:1m]) / 60) / (sum(increase(ai_lab_tokens_total[$__range])) / 1000000)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 6,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Idle share of running time",
      "description": "Minutes with no tokens processed, as a share of minutes the instance was running.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "clamp_min(1 - (count_over_time((sum(increase(ai_lab_tokens_total[5m])) > 0)[$__range:5m]) * 5) / (count_over_time(max(ai_lab_exporter_last_success_timestamp_seconds)[$__range:1m])), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 7,
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": 8,
      "type": "row",
      "title": "Compare with a hosted API",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Same tokens on a hosted API",
      "description": "Uses the two price variables at the top. Change them to match the API you compare against.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum(increase(ai_lab_tokens_total{direction=\"input\"}[$__range])) / 1000000 * $price_in + sum(increase(ai_lab_tokens_total{direction=\"output\"}[$__range])) / 1000000 * $price_out",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Lab minus hosted",
      "description": "Negative means the lab was cheaper for this usage.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "(max(ai_lab_instance_hourly_cost_usd) * count_over_time(max(ai_lab_exporter_last_success_timestamp_seconds)[$__range:1m]) / 60) - (sum(increase(ai_lab_tokens_total{direction=\"input\"}[$__range])) / 1000000 * $price_in + sum(increase(ai_lab_tokens_total{direction=\"output\"}[$__range])) / 1000000 * $price_out)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0,
                "color": "orange"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      },
      "id": 10,
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 4
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Over time",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Tokens per 5 minutes, by model",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum by (model) (increase(ai_lab_tokens_total[5m]))",
          "legendFormat": "{{model}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens per 5 minutes, input and output",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum by (direction) (increase(ai_lab_tokens_total[5m]))",
          "legendFormat": "{{direction}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Messages per 5 minutes, by model",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum by (model) (increase(ai_lab_messages_total[5m]))",
          "legendFormat": "{{model}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Tokens per message",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "sum(increase(ai_lab_tokens_total[15m])) / clamp_min(sum(increase(ai_lab_messages_total[15m])), 1)",
          "legendFormat": "tokens per message",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      }
    }
  ]
}
