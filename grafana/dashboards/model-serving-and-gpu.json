{
  "uid": "ai-lab-model-gpu",
  "title": "AI Lab: Model serving and GPU",
  "description": "Why is it slow? Which model is loaded, how much of it is on the GPU, and how the GPU is coping.",
  "tags": [
    "ai-lab"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "ds_prom",
        "label": "Metrics",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "datasource",
        "name": "ds_loki",
        "label": "Logs",
        "query": "loki",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "multi": false,
        "includeAll": false
      },
      {
        "type": "datasource",
        "name": "ds_cw",
        "label": "CloudWatch",
        "query": "cloudwatch",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": [],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Loaded models",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Loaded models",
      "description": "Size in memory and the share that fits in GPU memory (1 = all of it).",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_ollama_model_vram_ratio",
          "legendFormat": "",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B",
          "expr": "ai_lab_ollama_model_size_bytes",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "In GPU memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Size in memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "instance_id": true
            },
            "renameByName": {
              "model": "Model",
              "Value #A": "In GPU memory",
              "Value #B": "Size in memory"
            }
          }
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "type": "table",
      "title": "Configured model settings",
      "description": "Temperature, top_p, top_k and context size as set in Open WebUI.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_model_param",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "instance": true,
              "job": true,
              "instance_id": true
            },
            "renameByName": {
              "model": "Model",
              "param": "Setting",
              "Value": "Value"
            }
          }
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 7
      }
    },
    {
      "id": 4,
      "type": "row",
      "title": "GPU",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Temperature",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_gpu_temperature_celsius",
          "legendFormat": "GPU {{gpu}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 8,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Utilization",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_gpu_utilization_ratio",
          "legendFormat": "GPU {{gpu}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 8,
        "y": 9,
        "w": 8,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Power",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_gpu_power_watts",
          "legendFormat": "draw",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B",
          "expr": "ai_lab_gpu_power_limit_watts",
          "legendFormat": "limit",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 16,
        "y": 9,
        "w": 8,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "GPU memory",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_gpu_memory_used_bytes",
          "legendFormat": "used",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "B",
          "expr": "ai_lab_gpu_memory_total_bytes",
          "legendFormat": "total",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 8,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Throttling",
      "description": "Appears only while the GPU reports a throttle reason.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_gpu_throttled == 1",
          "legendFormat": "{{reason}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 8,
        "y": 16,
        "w": 8,
        "h": 7
      }
    },
    {
      "type": "timeseries",
      "title": "Model in GPU memory",
      "description": "Anything under 100% means part of the model runs on the CPU.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_ollama_model_vram_ratio",
          "legendFormat": "{{model}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 7
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Telemetry sources",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Exporter sources up",
      "description": "0 means the exporter could not read that source this run.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "ai_lab_exporter_source_up",
          "legendFormat": "{{source}}",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Seconds since the exporter last succeeded",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds_prom}"
          },
          "refId": "A",
          "expr": "time() - max(ai_lab_exporter_last_success_timestamp_seconds)",
          "legendFormat": "age",
          "instant": false,
          "range": true
        }
      ],
      "datasource": {
        "type": "prometheus",
        "uid": "${ds_prom}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 6
      }
    }
  ]
}
